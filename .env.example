# ─── AI Providers ─────────────────────────────────────────────
# Groq (https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Kilo AI Gateway (https://kilo.ai/docs/gateway/authentication)
KILO_API_KEY=
KILO_MODEL=anthropic/claude-sonnet-4.5

# Provider failover order — comma separated
PROVIDER_PRIORITY=groq,gemini,kilo

# ─── Research (real web search) ───────────────────────────────
# Tavily (https://tavily.com) — free tier: 1000 credits/month
TAVILY_API_KEY=

# ─── Storage (Vercel Postgres / Neon) ─────────────────────────
DATABASE_URL=

# ─── Private deployment guard ─────────────────────────────────
# Optional shared secret. If set, every API route requires
# header  x-znotes-key: <value>  or  ?key=<value>.
# Leave blank for a truly private deployment behind Vercel
# Protection / a private network.
ZNOTES_ACCESS_KEY=

# ─── Limits ───────────────────────────────────────────────────
MAX_UPLOAD_MB=5
REQUEST_TIMEOUT_MS=60000
